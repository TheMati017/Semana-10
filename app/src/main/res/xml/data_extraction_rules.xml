<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas para API 31+ (android:dataExtractionRules). Se excluye todo dato sensible tanto del
   backup en la nube como de la transferencia directa entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
