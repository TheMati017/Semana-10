<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- La aplicación no necesita tráfico HTTP en claro. Se mantienen las CA del sistema. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
